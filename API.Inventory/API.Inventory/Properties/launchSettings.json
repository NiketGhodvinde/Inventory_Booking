            "environmentVariables": {
                "ASPNETCORE_ENVIRONMENT": "Development"
            }
        },
        "IIS Express": {
            "commandName": "IISExpress",
            "launchBrowser": false,
            "launchUrl": "swagger",
            "environmentVariables": {
                "ASPNETCORE_ENVIRONMENT": "Development"
            }
        },
        "Production": {
            "commandName": "Project",
            "dotnetRunMessages": true,
            "launchBrowser": false,
            "launchUrl": "swagger",
            "applicationUrl": "http://192.168.0.12:82", // Change the port if necessary
            "environmentVariables": {
                "ASPNETCORE_ENVIRONMENT": "Production"
            }
        }
